#!/bin/sh
# m: wrapper para @pasosdejesus/m (instalación local, rápido)
#
# Instala @pasosdejesus/m en M_DIR (por defecto ~/.m-cli) y lo ejecuta
# directo con node, evitando la sobrecarga de npx en cada invocación.
#
# Online: si pasaron M_TTL segundos (por defecto 86400 = 1 día) desde la
#         última actualización, intenta actualizar a @latest.
# Offline: usa la copia instalada sin tocar la red.
#
# Dominio público de acuerdo a legislación colombiana.
# http://www.pasosdejesus.org/dominio_publico_colombia.html
# 2026. vtamara@pasosdeJesus.org
#
# Requiere node (que incluye npm).

M_DIR="${M_DIR:-$HOME/.m-cli}"
M_BIN="$M_DIR/node_modules/@pasosdejesus/m/dist/m.js"
M_STAMP="$M_DIR/.actualizado"
M_TTL="${M_TTL:-86400}"

# Detectar node/npm: el paquete node de OpenBSD incluye ambos
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "m: se requiere el paquete node (incluye npm): doas pkg_add node" >&2
  exit 1
fi

instala() {
  npm install --prefix "$M_DIR" --no-fund --no-audit \
    @pasosdejesus/m@latest >/dev/null 2>&1
}

# Instalar si no existe
if [ ! -f "$M_BIN" ]; then
  if ! instala; then
    echo "m: no se pudo instalar @pasosdejesus/m (¿sin conexión?)" >&2
    exit 1
  fi
  date +%s > "$M_STAMP"
fi

# Actualizar si pasó el TTL (solo si hay conexión)
ahora=$(date +%s)
ultimo=$(cat "$M_STAMP" 2>/dev/null || echo 0)
if [ "$M_TTL" = "0" ] || [ $((ahora - ultimo)) -ge "$M_TTL" ]; then
  if instala; then
    date +%s > "$M_STAMP"
  fi
fi

exec node "$M_BIN" "$@"
