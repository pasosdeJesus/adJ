#!/bin/sh
# Prepara la máquina anfitrión para alojar una VM con Crush y DeepSeek.
# Crea VM en vmd(8), configura red puente, exporta NFS y opcionalmente
# instala adJ de forma automática.
# Dominio público de acuerdo a legislación colombiana.
# http://www.pasosdejesus.org/dominio_publico_colombia.html
# 2026. vtamara@pasosdeJesus.org

# Configuración esperada en el ambiente:
#   VM_NOMBRE   - Nombre de la VM (defecto: adJ-ia)
#   VM_DISCO    - Ruta del disco qcow2 (defecto: /var/vmm/${VM_NOMBRE}.qcow2)
#   VM_MEMORIA  - RAM para la VM (defecto: 12G)
#   VM_TAMDISCO - Tamaño del disco (defecto: 50G)
#   RED_IP_HOST - IP del anfitrión en la red interna (defecto: 100.64.1.2)
#   RED_IP_VM   - IP de la VM (defecto: 100.64.1.3)
#   RED_MASCARA - Máscara de subred para NFS (defecto: 255.255.0.0)
#   NFS_PATH    - Directorio a exportar via NFS (defecto: /var/www)
#   ISO_PATH    - Ruta de la ISO de adJ (defecto: ./AprendiendoDeJesus-*.iso)
#   INSTALAR    - 's' para autoinstalar sin preguntar, 'n' para saltar
#   CLAVE_ROOT  - Clave del usuario root en la VM (requerido si INSTALAR=s)
#   VM_USUARIO  - Usuario inicial en la VM (defecto: vtamara)
#   ZONA_HORARIA- Zona horaria (defecto: America/Bogota)
#   DNS_SERVER  - Servidor DNS para la VM (defecto: 8.8.8.8)

set -e
export PATH="$PATH:/usr/local/bin:/usr/local/sbin:/usr/sbin:/sbin"

# ---- Parsear argumentos ----
AUTO=0
ARG_NOMBRE=""
ARG_MEMORIA=""
ARG_DISCO=""
while [ $# -gt 0 ]; do
	case "$1" in
		-auto) AUTO=1; shift ;;
		-*) echo "Opción desconocida: $1"; exit 1 ;;
		*)
			if [ -z "${ARG_NOMBRE}" ]; then
				ARG_NOMBRE="$1"
			elif [ -z "${ARG_MEMORIA}" ]; then
				ARG_MEMORIA="$1"
			elif [ -z "${ARG_DISCO}" ]; then
				ARG_DISCO="$1"
			else
				echo "Demasiados argumentos: $1"; exit 1
			fi
			shift
			;;
	esac
done

# ---- Valores por defecto (args > ambiente > built-in) ----
# Detectar usuario real (doas expone DOAS_USER; sino logname; sino whoami)
acus="${DOAS_USER:-$(logname 2>/dev/null || whoami)}"
VM_NOMBRE="${ARG_NOMBRE:-${VM_NOMBRE:-adJ-ia}}"
VM_MEMORIA="${ARG_MEMORIA:-${VM_MEMORIA:-12G}}"
VM_TAMDISCO="${VM_TAMDISCO:-50G}"
VM_DISCO="${ARG_DISCO:-${VM_DISCO:-/var/vmm/${VM_NOMBRE}.qcow2}}"
RED_IP_HOST="${RED_IP_HOST:-100.64.1.2}"
RED_IP_VM="${RED_IP_VM:-100.64.1.3}"
RED_MASCARA="${RED_MASCARA:-255.255.0.0}"
NFS_PATH="${NFS_PATH:-/var/www}"
NFS_RED="${NFS_RED:-100.64.0.0}"
owndir=$(stat -f '%Su' ".")
VM_USUARIO="${VM_USUARIO:-$owndir}"
VM_UID="${VM_UID:-$(id -u "$acus" 2>/dev/null || echo 1000)}"
ZONA_HORARIA="${ZONA_HORARIA:-America/Bogota}"
DNS_SERVER="${DNS_SERVER:-8.8.8.8}"
NFS_PATH="${NFS_PATH:-/var/www}"
ISO_PATH="${ISO_PATH:-}"
CLAVE_ROOT="${CLAVE_ROOT:-}"

w=$(whoami)
if [ "$w" != "root" ]; then
  echo "Este script debe ser ejecutado por root o con doas"
  exit 1
fi

# ---- Helpers ----
if which dialog > /dev/null 2>&1; then
	HAVE_DIALOG=1
else
	HAVE_DIALOG=0
fi

preguntar() {
	# $1 = título, $2 = mensaje, $3 = default (yes/no)
	local titulo="$1" mensaje="$2" def="$3"
	if [ "$AUTO" -eq 1 ]; then
		return 0
	fi
	if [ "$HAVE_DIALOG" -eq 1 ]; then
		dialog --clear --title "$titulo" --yesno "$mensaje" 0 0
		local rc=$?
		clear
		return $rc
	else
		printf "%s [S/n]: " "$mensaje"
		read r
		case "$r" in
			[Nn]*) return 1 ;;
			*) return 0 ;;
		esac
	fi
}

mostrar_info() {
	if [ "$AUTO" -eq 1 ]; then
		return 0
	fi
	if [ "$HAVE_DIALOG" -eq 1 ]; then
		dialog --title "$1" --msgbox "$2" 0 0
	else
		echo ""
		echo "--- $1 ---"
		echo "$2"
		echo ""
	fi
}

echo "=== prep-vm-ia-anfitrion: VM ${VM_NOMBRE} ==="

RESUMEN="VM:       ${VM_NOMBRE}
Disco:    ${VM_DISCO}
Memoria:  ${VM_MEMORIA}
Usuario:  ${VM_USUARIO} (uid=${VM_UID})
Zona hor: ${ZONA_HORARIA}
NFS:      ${NFS_PATH}

¿Continuar con esta configuración?"

if [ "$HAVE_DIALOG" -eq 1 ] && [ "$AUTO" -eq 0 ]; then
	dialog --clear --title "prep-vm-ia-anfitrion" --yesno "$RESUMEN" 13 60 || exit 0
	clear
else
	echo "$RESUMEN"
	echo ""
	if [ "$AUTO" -eq 0 ]; then
		preguntar "Configuración" "¿Continuar con esta configuración?" || exit 0
	fi
fi

# Mostrar estado actual antes de proceder
echo ""
echo "=== Estado actual ==="
echo "--- /etc/vm.conf ---"
grep -A5 'vm "' /etc/vm.conf 2>/dev/null || echo "  (sin VMs configuradas)"
echo ""
echo "--- vmctl show ---"
vmctl show 2>/dev/null || echo "  (sin VMs corriendo)"
echo ""
echo "--- discos en /var/vmm ---"
ls -lh /var/vmm/*.qcow2 2>/dev/null || echo "  (sin discos en /var/vmm)"
ls -lh /restovar/*.qcow2 2>/dev/null || true
echo ""

if [ "$AUTO" -eq 0 ] && [ "$HAVE_DIALOG" -eq 0 ]; then
	preguntar "Estado" "¿Continuar?" || exit 0
fi

# ---- Directorios NFS ----
echo "[nfs] Verificando directorios..."
for d in "$NFS_PATH"; do
  if [ ! -d "$d" ]; then
    mkdir -p "$d"
    echo "  + $d creado"
  else
    echo "  = $d ya existe"
  fi
done

# ---- NFS exports (para todas las subredes 100.64.x) ----
echo "[nfs] Verificando /etc/exports..."
if ! grep -q "^${NFS_PATH} " /etc/exports 2>/dev/null; then
  echo "${NFS_PATH} -alldirs -network=${NFS_RED} -mask=${RED_MASCARA} -maproot=root" >> /etc/exports
  rcctl enable portmap mountd nfsd 2>/dev/null || true
  rcctl restart portmap mountd nfsd 2>/dev/null || true
  echo "  + ${NFS_PATH} exportado para ${NFS_RED}/${RED_MASCARA}"
else
  echo "  = ${NFS_PATH} ya exportado"
fi

# ---- Sysctl forwarding ----
echo "[sysctl] Verificando forwarding..."
if ! grep -q '^net.inet.ip.forwarding=1' /etc/sysctl.conf 2>/dev/null; then
  echo 'net.inet.ip.forwarding=1' >> /etc/sysctl.conf
  sysctl net.inet.ip.forwarding=1
  echo "  + forwarding activado"
else
  echo "  = forwarding ya activo"
fi

# ---- Buscar ISO ----
if [ -z "$ISO_PATH" ]; then
  for p in AprendiendoDeJesus-*-amd64.iso \
    ../AprendiendoDeJesus-*-amd64.iso \
    /releasedir/AprendiendoDeJesus-*-amd64.iso; do
    if [ -f "$p" ]; then
      ISO_PATH="$p"
      break
    fi
  done
fi

if [ -n "$ISO_PATH" ] && [ -f "$ISO_PATH" ]; then
	echo "  = ISO detectada: ${ISO_PATH}"
else
	echo "ERROR: No se detectó ISO de adJ. Genérela con hdes/creaiso.sh"
	echo "  o defina ISO_PATH y vuelva a ejecutar."
	exit 1
fi

rc=0
pgrep vmd || rc=$?
if (test "$rc" != "0") then {
  echo "Habilitando e iniciando vmd"
  rcctl enable vmd 2>/dev/null || true
  rcctl start vmd 2>/dev/null || true
} fi;


# ---- Disco VM ----
echo ""
echo "[disco] ${VM_DISCO}..."

if [ -f "$VM_DISCO" ]; then
	tam=$(stat -f '%z' "$VM_DISCO" 2>/dev/null || echo 0)
	# qcow2 vacío: ~256KB. Instalado: >100MB (base + sets)
	if [ "$tam" -lt 104857600 ]; then
		echo "  ! disco existe pero parece no instalado (${tam} bytes) — se reinstalará"
		rm -f "$VM_DISCO"
	else
		echo "  = disco ya instalado (${tam} bytes) — se omite creación e instalación"
	fi
fi
if [ ! -f "$VM_DISCO" ]; then
  mkdir -p "$(dirname "$VM_DISCO")"
  vmctl -v create -s "$VM_TAMDISCO" "$VM_DISCO" 
  ls -l $VM_DISCO
  eval $(stat -s $VM_DISCO)
  tamvmdisco=$st_size

  echo "  + disco ${VM_DISCO} creado (${VM_TAMDISCO})"

  if [ -z "$CLAVE_ROOT" ]; then
    stty -echo
    echo -n "Clave para root y ${VM_USUARIO} en la VM: "
    read CLAVE_ROOT
    stty echo
    echo ""
    if [ -z "$CLAVE_ROOT" ]; then
      echo "Error: Se requiere una clave"
      exit 1
    fi
  fi

  echo "Creando /var/www/htdocs/install.conf"
  cat > /var/www/htdocs/install.conf  <<EOF 
Nombre de la maquina = $VM_NOMBRE
Clave para root = $CLAVE_ROOT
Cambiar consola a com0 = si
Cual velocidad deberia com0 usar = 19200
Crear cuenta de usuario = ${VM_USUARIO}
clave para la cuenta = ${CLAVE_ROOT}
Zona horaria = ${ZONA_HORARIA}
Usar (T)odo el disco MBR, todo el disco (G)PT o (E)ditar = T
URL de la plantilla de autoparticionado para disklabel = http://${RED_IP_HOST}/template.disklabel
Usar distribucion (A)utolocalizada, (E)ditarla, o (C)rear una distribucion = a
Ruta a componentes = /
Continuar en todo caso = si
Continuar sin verificacion = si
Set to = si
EOF

  echo "Creando /var/www/htdocs/template.disklabel"
  cat > /var/www/htdocs/template.disklabel  <<EOF 
/         38G-*         90%
swap      6G-12G        10%
EOF

  rc=0
  grep "server_name  localhost $RED_IP_HOST;" /etc/nginx/nginx.conf > /dev/null 2>&1 || rc=$?
  if (test "$rc" != "0") then {
    echo "Ajustando nginx.conf"
    cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.copia
    awk '/listen[[:space:]]+80;/,/root[[:space:]]+\/var\/www\/htdocs;/ {
    if(/server_name[[:space:]]+localhost;/) sub(/localhost;/, "localhost ${RED_IP_HOST};")
    } 1' /etc/nginx/nginx.conf.copia > /etc/nginx/nginx.conf
  } fi;

  echo "Reiniciando nginx"
  rcctl -d restart nginx

  echo "Iniciando maquina virtual para autoinstalación, ante la pregunta eliga Autoinstall"
  cmd="vmctl start -m 2G -B cdrom -r $ISO_PATH -d $VM_DISCO -L -c \"$VM_NOMBRE\""
  echo $cmd
  eval $cmd

  echo "  + instalación completada"

  ls -l $VM_DISCO
  eval $(stat -s $VM_DISCO)
  tamvmdiscofin=$st_size

  if (test "$tamvmdisco" = "$tamvmdiscofin") then {
    echo "No cambio el tamaño del disco virtual, no funcionó la instalación, elimine $VM_DISCO y vuelva a ejecutar"
    exit 1;
  } fi;


else
  echo "  = disco ${VM_DISCO} ya existe suponemos que ya se instaló"
fi

vmctl show 2>/dev/null | grep -q "$VM_NOMBRE" || true

echo "[vmd] Configurando /etc/vm.conf..."
if ! grep -q "vm \"${VM_NOMBRE}\"" /etc/vm.conf 2>/dev/null; then
  cat >> /etc/vm.conf << FINVM
# VM para Crush/DeepSeek - generada por prep-vm-ia-anfitrion
vm "${VM_NOMBRE}" {
  memory ${VM_MEMORIA}
  enable
  disk "${VM_DISCO}"
  local interface
}
FINVM
  rcctl restart vmd 2>/dev/null || true
  echo "  + VM ${VM_NOMBRE} configurada en /etc/vm.conf"
else
  echo "  = VM ${VM_NOMBRE} ya configurada"
fi

# 2. inst-adJ.sh
echo ""
echo "Paso 2: Configuración adJ (inst-adJ.sh)"
EJECUTO_INSTADJ=0
if [ "$AUTO" -eq 0 ]; then
	preguntar "inst-adJ.sh" "¿Ya ejecutó inst-adJ.sh dentro de ${VM_NOMBRE}?" && EJECUTO_INSTADJ=1
else
	EJECUTO_INSTADJ=1
fi

# 3. prep-vm-ia-invitado
EJECUTO_INVITADO=0
if [ "$EJECUTO_INSTADJ" -eq 1 ]; then
	echo ""
	echo "Paso 3: Preparación IA (prep-vm-ia-invitado)"
	if [ "$AUTO" -eq 0 ]; then
		preguntar "prep-vm-ia-invitado" "¿Ya ejecutó prep-vm-ia-invitado en ${VM_NOMBRE}?" && EJECUTO_INVITADO=1
	else
		EJECUTO_INVITADO=1
	fi
fi

# Arrancar VM
echo ""
if vmctl show 2>/dev/null | grep -q "\"${VM_NOMBRE}\""; then
	echo "  = VM ${VM_NOMBRE} ya está corriendo"
else
	if [ "$EJECUTO_INVITADO" -eq 1 ]; then
		# Todo listo: arrancar en background, acceso por SSH
		echo "  + arrancando ${VM_NOMBRE} en background (IP: ${RED_IP_VM})"
		vmctl start "$VM_NOMBRE"
		sleep 3
		echo "  + Puede ingresar con: ssh ${VM_USUARIO}@${RED_IP_VM}"
	elif [ "$EJECUTO_INSTADJ" -eq 1 ]; then
		# Falta prep-vm-ia-invitado: arrancar con consola
		echo "  + arrancando ${VM_NOMBRE} con consola para ejecutar prep-vm-ia-invitado"
		echo "    Dentro de la VM ejecute: doas IA_USER=${VM_USUARIO} /usr/local/adJ/prep-vm-ia-invitado"
		vmctl start -c "$VM_NOMBRE"
	else
		# Falta inst-adJ.sh: arrancar con consola
		echo "  + arrancando ${VM_NOMBRE} con consola para ejecutar inst-adJ.sh"
		echo "    Dentro de la VM ejecute: doas /inst-adJ.sh"
		vmctl start -c "$VM_NOMBRE"
	fi
fi

echo ""
echo "=== prep-vm-ia-anfitrion completado ==="
if [ "$INSTALAR" = "s" ]; then
  echo "adJ instalado. Ahora dentro de la VM:"
else
  echo "Próximos pasos:"
  echo "  1. Instalar adJ en la VM (ISO o red)"
fi
echo "  2. Ejecutar inst-adJ.sh"
echo "  3. Ejecutar prep-vm-ia-invitado"
echo ""
echo "IP del anfitrión: ${RED_IP_HOST%/*}"
echo "IP de la VM:      ${RED_IP_VM}"
echo "Consola:          vmctl console ${VM_NOMBRE}"
echo "Directorio NFS:   ${NFS_PATH}"

# Faltó prepara cortafuegos para puertos tcp,dup 111, 2049,873,958,20480
