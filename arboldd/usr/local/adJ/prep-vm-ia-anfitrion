#!/bin/sh
# Prepara la máquina anfitrión para alojar una VM con Crush y DeepSeek.
# Crea VM en vmd(8), red puente y exporta NFS.
# Dominio público de acuerdo a legislación colombiana.
# http://www.pasosdejesus.org/dominio_publico_colombia.html
# 2026. vtamara@pasosdeJesus.org

# Configuración esperada en el ambiente:
#   VM_NOMBRE   - Nombre de la VM (requerido, ej: adJ-ia)
#   VM_DISCO    - Ruta del disco qcow2 (defecto: /var/vmm/${VM_NOMBRE}.qcow2)
#   VM_MEMORIA  - RAM para la VM (defecto: 4G)
#   VM_TAMDISCO - Tamaño del disco (defecto: 30G)
#   RED_PUENTE  - Interfaz puente (defecto: bridge0)
#   RED_IP_HOST - IP del anfitrión en red puente (defecto: 100.64.1.2/24)
#   RED_IP_VM   - IP de la VM (defecto: 100.64.1.3)
#   NFS_PATH    - Directorio a exportar via NFS (defecto: /var/www)

set -e

VM_NOMBRE="${VM_NOMBRE:-adJ-ia}"
VM_DISCO="${VM_DISCO:-/var/vmm/${VM_NOMBRE}.qcow2}"
VM_MEMORIA="${VM_MEMORIA:-4G}"
VM_TAMDISCO="${VM_TAMDISCO:-30G}"
RED_PUENTE="${RED_PUENTE:-bridge0}"
RED_IP_HOST="${RED_IP_HOST:-100.64.1.2/24}"
RED_IP_VM="${RED_IP_VM:-100.64.1.3}"
RED_MASCARA="${RED_MASCARA:-255.255.255.0}"
NFS_PATH="${NFS_PATH:-/var/www}"
NFS_RED="${NFS_RED:-100.64.1}"

echo "=== prep-vm-ia-anfitrion: Preparando anfitrión para VM ${VM_NOMBRE} ==="

# ---- Directorios NFS ----
echo "[nfs] Creando directorios a exportar..."
for d in "$NFS_PATH" "$NFS_PATH/usr/local" "$NFS_PATH/home" "$NFS_PATH/var/postgresql"; do
	if [ ! -d "$d" ]; then
		mkdir -p "$d"
		echo "  + $d creado"
	else
		echo "  = $d ya existe"
	fi
done

# ---- NFS exports ----
echo "[nfs] Configurando /etc/exports..."
if ! grep -q "^${NFS_PATH} " /etc/exports 2>/dev/null; then
	echo "${NFS_PATH} -alldirs -network=${NFS_RED} -mask=${RED_MASCARA}" >> /etc/exports
	rcctl enable portmap mountd nfsd 2>/dev/null || true
	rcctl restart portmap mountd nfsd 2>/dev/null || true
	echo "  + ${NFS_PATH} exportado para ${NFS_RED}/${RED_MASCARA}"
else
	echo "  = ${NFS_PATH} ya exportado"
fi

# ---- Red puente ----
echo "[red] Configurando puente ${RED_PUENTE}..."
if ! ifconfig "$RED_PUENTE" >/dev/null 2>&1; then
	ifconfig "$RED_PUENTE" create 2>/dev/null || true
fi
if ! ifconfig "$RED_PUENTE" 2>/dev/null | grep -q "inet ${RED_IP_HOST%/*}"; then
	ifconfig "$RED_PUENTE" inet "$RED_IP_HOST"
fi
if ! grep -q "^add ${RED_PUENTE}" /etc/hostname.bridge0 2>/dev/null; then
	if ! grep -q "$RED_PUENTE" /etc/hostname.bridge0 2>/dev/null; then
		echo "add ${RED_PUENTE}" > /etc/hostname.bridge0
		echo "inet ${RED_IP_HOST}" >> /etc/hostname.bridge0
		echo "up" >> /etc/hostname.bridge0
	fi
fi
echo "  + ${RED_PUENTE} configurado ${RED_IP_HOST}"

# ---- Sysctl forwarding ----
if ! grep -q '^net.inet.ip.forwarding=1' /etc/sysctl.conf 2>/dev/null; then
	echo 'net.inet.ip.forwarding=1' >> /etc/sysctl.conf
	sysctl net.inet.ip.forwarding=1
fi

# ---- Disco VM ----
echo "[disco] Creando disco ${VM_DISCO}..."
if [ ! -f "$VM_DISCO" ]; then
	mkdir -p "$(dirname "$VM_DISCO")"
	vmctl create "$VM_DISCO" -s "$VM_TAMDISCO"
	echo "  + disco ${VM_DISCO} creado (${VM_TAMDISCO})"
else
	echo "  = disco ${VM_DISCO} ya existe"
fi

# ---- VM en vmd ----
echo "[vmd] Configurando /etc/vm.conf..."
if ! grep -q "vm \"${VM_NOMBRE}\"" /etc/vm.conf 2>/dev/null; then
	cat >> /etc/vm.conf << FINVM

# VM para Crush/DeepSeek - generada por prep-vm-ia-anfitrion
vm "${VM_NOMBRE}" {
	memory ${VM_MEMORIA}
	disk "${VM_DISCO}"
	interface {
		switch "local${VM_NOMBRE}"
	}
}
switch "local${VM_NOMBRE}" {
	interface ${RED_PUENTE}
}
FINVM
	rcctl enable vmd 2>/dev/null || true
	rcctl restart vmd 2>/dev/null || true
	echo "  + VM ${VM_NOMBRE} configurada en /etc/vm.conf"
else
	echo "  = VM ${VM_NOMBRE} ya configurada"
fi

# ---- Iniciar VM ----
echo "[vmd] Verificando estado de VM..."
vmctl show 2>/dev/null | grep -q "$VM_NOMBRE" || true
vmctl start "$VM_NOMBRE" 2>/dev/null && echo "  + VM ${VM_NOMBRE} iniciada" || echo "  = VM ya estaba corriendo"

echo ""
echo "=== prep-vm-ia-anfitrion completado ==="
echo "Próximos pasos:"
echo "  1. Instalar adJ en la VM (ISO o red)"
echo "  2. Dentro de la VM ejecutar inst-adJ.sh"
echo "  3. Luego ejecutar prep-vm-ia-invitado"
echo ""
echo "IP del anfitrión: ${RED_IP_HOST%/*}"
echo "IP de la VM:      ${RED_IP_VM}"
echo "Directorio NFS:   ${NFS_PATH}"
